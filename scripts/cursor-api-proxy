#!/usr/bin/env bash
# cursor-api-proxy — launcher (install to ~/.local/bin/cursor-api-proxy).
# Requires: Node 18+, built dist/cli.js under CURSOR_API_PROXY_ROOT.

set -euo pipefail

LABEL="com.cursor-api-proxy"
PLIST="${HOME}/Library/LaunchAgents/${LABEL}.plist"
STORAGE="${HOME}/.cursor-api-proxy"
LOG="${STORAGE}/proxy.log"
PIDFILE="${STORAGE}/proxy.pid"

PORT="${CURSOR_BRIDGE_PORT:-8765}"
HOST="${CURSOR_BRIDGE_HOST:-127.0.0.1}"

LOCALE_SOURCE="${CURSOR_API_PROXY_LANG:-${LC_ALL:-${LC_MESSAGES:-${LANG:-en}}}}"
case "$LOCALE_SOURCE" in
  zh*|ZH*) APP_LANG="zh-CN" ;;
  *) APP_LANG="en" ;;
esac
export CURSOR_API_PROXY_LANG="$APP_LANG"

_msg() {
  if [[ "$APP_LANG" == "zh-CN" ]]; then
    printf '%s' "$2"
  else
    printf '%s' "$1"
  fi
}

_say() {
  _msg "$1" "$2"
  printf '\n'
}

_err() {
  _msg "$1" "$2" >&2
  printf '\n' >&2
}

_resolve_root() {
  if [[ -n "${CURSOR_API_PROXY_ROOT:-}" ]]; then
    echo "${CURSOR_API_PROXY_ROOT}"
    return
  fi
  # Follow symlinks (e.g. ~/.local/bin/cursor-api-proxy -> .../scripts/...)
  # so we can locate the repo's scripts/ dir even when invoked via the symlink.
  local self="${BASH_SOURCE[0]:-$0}"
  while [[ -L "$self" ]]; do
    local link
    link="$(readlink "$self")"
    if [[ "$link" = /* ]]; then
      self="$link"
    else
      self="$(cd "$(dirname "$self")" && pwd -P)/$link"
    fi
  done
  local dir
  dir="$(cd "$(dirname "$self")" && pwd -P)"
  if [[ "$(basename "$dir")" == "scripts" ]]; then
    echo "$(cd "$dir/.." && pwd -P)"
    return
  fi
  echo ""
}

ROOT="$(_resolve_root)"

# Lazy node lookup: only commands that actually need node (start/run/enable)
# call _entry. Doing this at top-level used to kill the script under
# `set -euo pipefail` when launchd's minimal PATH had no `node`, even for
# `stop`/`health` which don't need node at all.
#
# Returns "<node>|<cli.js>" on stdout, or non-zero exit + stderr message.
# Callers MUST guard with `if ! out=$(_entry); then exit 1; fi` — using
# `IFS=| read … <<<"$(_entry)"` masks the failure (issue: empty $node + $exe
# leading to `nohup: : No such file or directory`).
_entry() {
  if [[ -z "$ROOT" ]]; then
    _err \
      "Set CURSOR_API_PROXY_ROOT to your cursor-api-proxy checkout (directory containing dist/cli.js)." \
      "请将 CURSOR_API_PROXY_ROOT 设置为 cursor-api-proxy 项目目录（其中应包含 dist/cli.js）。"
    return 1
  fi
  local cli="${ROOT}/dist/cli.js"
  if [[ ! -f "$cli" ]]; then
    _err \
      "Missing ${cli} — run: cd \"$ROOT\" && npm install && npm run build" \
      "缺少 ${cli}，请运行：cd \"$ROOT\" && npm install && npm run build"
    return 1
  fi
  local node_bin="${CURSOR_API_PROXY_NODE:-}"
  if [[ -z "$node_bin" ]]; then
    node_bin="$(command -v node 2>/dev/null || true)"
  fi
  if [[ -z "$node_bin" || ! -x "$node_bin" ]]; then
    # launchd/widget can run with a minimal PATH; probe common install locations.
    local candidates=(
      "${HOME}/.local/bin/node"
      "/opt/homebrew/bin/node"
      "/usr/local/bin/node"
      "${HOME}/.volta/bin/node"
      "${HOME}/.asdf/shims/node"
    )
    local nvm_root="${HOME}/.nvm/versions/node"
    if [[ -d "$nvm_root" ]]; then
      local nvm_ver
      for nvm_ver in "$nvm_root"/*; do
        [[ -d "$nvm_ver" ]] || continue
        candidates+=("${nvm_ver}/bin/node")
      done
    fi
    local candidate
    for candidate in "${candidates[@]}"; do
      if [[ -x "$candidate" ]]; then
        node_bin="$candidate"
        break
      fi
    done
  fi
  if [[ -z "$node_bin" || ! -x "$node_bin" ]]; then
    _err \
      "node not found. Install Node 18+ or set CURSOR_API_PROXY_NODE." \
      "找不到 node。请安装 Node 18+ 或设置 CURSOR_API_PROXY_NODE。"
    return 1
  fi
  echo "$node_bin|$cli"
}

# Tiny helper: resolve _entry and split into $node / $exe in the caller's scope,
# but propagate the failure (unlike `<<<"$(_entry)"`).
_load_entry() {
  local entry
  if ! entry="$(_entry)"; then
    return 1
  fi
  IFS='|' read -r node exe <<<"$entry"
  if [[ -z "${node:-}" || -z "${exe:-}" ]]; then
    _err \
      "Internal error: empty node/cli from _entry" \
      "内部错误：_entry 返回了空的 node/cli 路径"
    return 1
  fi
}

_http_ok() {
  local scheme="http"
  if curl -kfsS --max-time 2 "${scheme}://${HOST}:${PORT}/healthz" 2>/dev/null | grep -qx ok; then
    return 0
  fi
  return 1
}

_read_pid() {
  if [[ -f "$PIDFILE" ]]; then
    tr -d ' \n' <"$PIDFILE" || true
  fi
}

_pid_alive() {
  local p="${1:-}"
  [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null
}

_health_text() {
  _say "cursor-api-proxy launcher" "cursor-api-proxy 启动器"
  local root_value="$ROOT"
  if [[ -z "$root_value" ]]; then
    root_value="$(_msg "(unset — set CURSOR_API_PROXY_ROOT)" "（未设置，请设置 CURSOR_API_PROXY_ROOT）")"
  fi
  _say "  ROOT: $root_value" "  项目目录：$root_value"
  _say "  URL:  http://${HOST}:${PORT}/" "  地址：http://${HOST}:${PORT}/"
  _say "  log:  $LOG" "  日志：$LOG"
  _say "  pid:  $PIDFILE" "  PID 文件：$PIDFILE"
  local lp=false
  if [[ "$(uname -s)" == "Darwin" ]] && launchctl list 2>/dev/null | grep -q "$LABEL"; then
    lp=true
  fi
  if [[ "$lp" == true ]]; then
    _say "  launchd: loaded" "  launchd：已加载"
  else
    _say "  launchd: not loaded" "  launchd：未加载"
  fi
  local pid="$(_read_pid)"
  if _pid_alive "$pid"; then
    _say "  process: RUNNING (pid $pid)" "  进程：运行中（PID $pid）"
  else
    _say \
      "  process: not running (stale pid file ignored if any)" \
      "  进程：未运行（已忽略可能存在的过期 PID 文件）"
  fi
  if _http_ok; then
    _say "  /healthz: ok" "  /healthz：正常"
  else
    _say "  /healthz: no response" "  /healthz：无响应"
  fi
  if [[ -f "$LOG" ]]; then
    _say "  last log lines:" "  最新日志："
    tail -n 5 "$LOG" 2>/dev/null | sed 's/^/    /' || true
  fi
}

cmd_start() {
  local node exe
  _load_entry || exit 1
  mkdir -p "$STORAGE"
  if _http_ok; then
    _say \
      "Already responding on http://${HOST}:${PORT}/healthz" \
      "服务已在 http://${HOST}:${PORT}/healthz 正常响应"
    exit 0
  fi
  local old="$(_read_pid)"
  if _pid_alive "$old"; then
    _err \
      "PID $old still alive but /healthz failed — try: $0 restart" \
      "PID $old 仍在运行，但 /healthz 检查失败，请尝试：$0 restart"
    exit 1
  fi
  _say "Starting (background) → $LOG" "正在后台启动 → $LOG"
  nohup "$node" "$exe" >>"$LOG" 2>&1 &
  local npid=$!
  echo "$npid" >"$PIDFILE" || true
  for _ in $(seq 1 20); do
    if _http_ok; then
      _say "OK — http://${HOST}:${PORT}/" "启动成功 — http://${HOST}:${PORT}/"
      exit 0
    fi
    sleep 0.15
  done
  _err \
    "Started, but no /healthz on port $PORT (see tail of $LOG)" \
    "进程已启动，但端口 $PORT 的 /healthz 无响应（请查看 $LOG 末尾）"
  exit 1
}

_stop_internal() {
  local pid="$(_read_pid)"
  if [[ "$(uname -s)" == "Darwin" ]] && launchctl list 2>/dev/null | grep -q "$LABEL"; then
    _err \
      "Note: launchd has $LABEL loaded — process may respawn. Run: $0 disable" \
      "注意：launchd 已加载 $LABEL，进程可能会自动重启。请运行：$0 disable"
  fi
  if ! _pid_alive "$pid"; then
    _say "Not running." "服务未运行。"
    rm -f "$PIDFILE" 2>/dev/null || true
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in $(seq 1 25); do
    if ! _pid_alive "$pid"; then
      _say "Stopped (pid $pid)" "已停止（PID $pid）"
      rm -f "$PIDFILE" 2>/dev/null || true
      return 0
    fi
    sleep 0.2
  done
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PIDFILE" 2>/dev/null || true
  _say "Force-stopped pid $pid" "已强制停止 PID $pid"
  return 0
}

cmd_stop() {
  _stop_internal
}

cmd_restart() {
  _stop_internal || true
  sleep 1
  cmd_start
}

cmd_rebuild() {
  if [[ -z "$ROOT" ]]; then
    _err \
      "Set CURSOR_API_PROXY_ROOT to your cursor-api-proxy checkout (directory containing dist/cli.js)." \
      "请将 CURSOR_API_PROXY_ROOT 设置为 cursor-api-proxy 项目目录（其中应包含 dist/cli.js）。"
    exit 1
  fi
  if ! command -v npm >/dev/null 2>&1; then
    _err \
      "npm not found in PATH. Install Node/npm or run with a shell that has npm." \
      "PATH 中找不到 npm。请安装 Node/npm，或在能找到 npm 的 Shell 中运行。"
    exit 1
  fi
  _say "Rebuilding in $ROOT" "正在 $ROOT 中重新构建"
  (
    cd "$ROOT"
    npm run build
  )
}

cmd_folder() {
  if [[ -z "$ROOT" ]]; then
    _err \
      "Set CURSOR_API_PROXY_ROOT to your cursor-api-proxy checkout." \
      "请将 CURSOR_API_PROXY_ROOT 设置为 cursor-api-proxy 项目目录。"
    exit 1
  fi
  if [[ "$(uname -s)" == "Darwin" ]]; then
    open "$ROOT"
    _say "Opened: $ROOT" "已打开：$ROOT"
    return 0
  fi
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open "$ROOT" >/dev/null 2>&1 || true
    _say "Opened: $ROOT" "已打开：$ROOT"
    return 0
  fi
  echo "$ROOT"
}

cmd_enable() {
  local node exe
  _load_entry || exit 1
  [[ "$(uname -s)" == "Darwin" ]] || {
    _err "launchd is macOS-only." "launchd 仅支持 macOS。"
    exit 1
  }
  mkdir -p "$(dirname "$PLIST")"
  local launcher
  launcher="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  cat >"$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${LABEL}</string>
  <key>WorkingDirectory</key><string>${ROOT}</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>CURSOR_API_PROXY_ROOT</key><string>${ROOT}</string>
    <key>CURSOR_API_PROXY_LANG</key><string>${APP_LANG}</string>
    <key>CURSOR_BRIDGE_PORT</key><string>${PORT}</string>
    <key>CURSOR_BRIDGE_HOST</key><string>${HOST}</string>
  </dict>
  <key>ProgramArguments</key>
  <array>
    <string>${launcher}</string>
    <string>run</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>${LOG}</string>
  <key>StandardErrorPath</key><string>${LOG}</string>
  </dict>
</plist>
EOF
  launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
  _say "Loaded $PLIST" "已加载 $PLIST"
}

cmd_disable() {
  [[ "$(uname -s)" == "Darwin" ]] || {
    _err "launchd is macOS-only." "launchd 仅支持 macOS。"
    exit 1
  }
  launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
  rm -f "$PLIST"
  _say \
    "Unloaded and removed plist (if it existed)." \
    "已卸载并删除 plist（如果原先存在）。"
}

cmd_run() {
  local node exe
  _load_entry || exit 1
  mkdir -p "$STORAGE"
  exec "$node" "$exe"
}

cmd_health() {
  _health_text
}

cmd_requests() {
  local node exe
  _load_entry || exit 1
  exec "$node" "$exe" requests "$@"
}

cmd_menu() {
  while true; do
    echo
    _health_text
    echo
    _say \
      "  1) start   2) stop   3) restart   4) health   5) enable   6) disable   7) rebuild   8) folder   q) quit" \
      "  1) 启动   2) 停止   3) 重启   4) 状态   5) 启用自启   6) 关闭自启   7) 重新构建   8) 打开目录   q) 退出"
    read -r -p "> " choice || exit 0
    case "$choice" in
      1) cmd_start ;;
      2) cmd_stop ;;
      3) cmd_restart ;;
      4) cmd_health ;;
      5) cmd_enable ;;
      6) cmd_disable ;;
      7) cmd_rebuild ;;
      8) cmd_folder ;;
      q|Q) exit 0 ;;
      *) _say "Unknown option" "未知选项" ;;
    esac
  done
}

main() {
  local sub="${1:-}"
  case "$sub" in
    start) cmd_start ;;
    stop) cmd_stop ;;
    restart) cmd_restart ;;
    health) cmd_health ;;
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    rebuild) cmd_rebuild ;;
    folder) cmd_folder ;;
    run) cmd_run ;;
    requests) shift; cmd_requests "$@" ;;
    "" ) cmd_health; echo; cmd_menu ;;
    *)
      _err \
        "Usage: $0 {start|stop|restart|health|enable|disable|rebuild|folder|run|requests}" \
        "用法：$0 {start|stop|restart|health|enable|disable|rebuild|folder|run|requests}"
      exit 2
      ;;
  esac
}

main "$@"
